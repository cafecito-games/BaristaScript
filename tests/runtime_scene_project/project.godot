; Engine configuration file.
; The committed runtime fixture: one Node in a real scene, driven by a BaristaScript script.
; Its assertions live in main.barista; tests/test_runtime_scene.py only supervises the run.

config_version=5

[application]

config/name="BaristaScript runtime fixture"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
